# 공공데이터포털 오픈API 인증키 (모든 표준데이터 API에 공통 사용)
# https://www.data.go.kr 에서 회원가입 후 활용신청하여 발급받으세요
# 지원 데이터셋: 가로수길, 보호수, 도시공원, 수목원
# 각 데이터셋별로 개별 활용신청이 필요합니다
VITE_DATA_API_KEY=your_api_key_here

# Naver Cloud Geocoding API (서버/CLI 전용 — VITE_ 접두사를 붙이지 마세요)
# https://console.ncloud.com/ → Maps → Application에서 Geocoding API 활성화 후 발급
# 꽃가루 패널은 Reverse Geocoding(gc) 서브 API도 함께 활성화해야 합니다(정지오코딩과 별개).
NAVER_GEOCODE_ID=your_naver_cloud_client_id
NAVER_GEOCODE_KEY=your_naver_cloud_client_secret

# ── 오늘의 꽃가루 패널 (서버 전용, VITE_ 금지) ────────────────────────────
# 기상청 꽃가루농도위험지수 3.0 — 나무 API와 별도 활용신청 필요 (데이터셋 15085289)
# https://www.data.go.kr/data/15085289/openapi.do  (호스트: apis.data.go.kr)
# 기존 VITE_DATA_API_KEY와 값이 같아도 서버 전용으로 별도 지정합니다.
KMA_POLLEN_KEY=your_kma_pollen_key

# Google Pollen API (한국은 grass만 제공) — Cloud Console에서 일일 쿼터·예산캡 필수
# https://developers.google.com/maps/documentation/pollen
GOOGLE_POLLEN_KEY=your_google_pollen_key

# Upstash Redis (Vercel Marketplace에서 생성) — 캐시 + rate limit + (Phase 2)구독 저장
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# CORS 허용 오리진(쉼표 구분, 프로덕션 도메인). *.vercel.app 프리뷰는 코드에서 자동 허용.
# 로컬 dev(vercel dev) 테스트 시 http://localhost:3000 등을 쉼표로 추가하세요
ALLOWED_ORIGINS=https://your-production-domain
